{% doc %}
  @prompt
    single image banner that can be linked to a product or collection
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign banner_link = blank
  if block.settings.product != blank
    assign banner_link = block.settings.product.url
  elsif block.settings.collection != blank
    assign banner_link = block.settings.collection.url
  endif
%}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-image-banner-{{ ai_gen_id }}__link,
  .ai-image-banner-{{ ai_gen_id }}__media {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-image-banner-{{ ai_gen_id }}__media {
    position: relative;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    background: #f7f3eb;
  }

  .ai-image-banner-{{ ai_gen_id }}__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-banner-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #333333;
  }

  .ai-image-banner-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 420px;
    max-height: 420px;
  }

  .ai-image-banner-{{ ai_gen_id }}__empty-state {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    padding: 10px 14px;
    color: #333333;
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
    background: rgba(255, 255, 255, 0.9);
  }

  .ai-image-banner-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid #4b5c47;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-image-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if banner_link != blank %}
    <a
      class="ai-image-banner-{{ ai_gen_id }}__link"
      href="{{ banner_link }}"
      aria-label="{{ block.settings.alt_text | escape }}"
    >
  {% endif %}

  <div class="ai-image-banner-{{ ai_gen_id }}__media">
    {% if block.settings.image != blank %}
      <img
        src="{{ block.settings.image | image_url: width: 2400 }}"
        alt="{{ block.settings.alt_text | escape }}"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        loading="lazy"
      >
    {% else %}
      <div class="ai-image-banner-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <span class="ai-image-banner-{{ ai_gen_id }}__empty-state">Add an image to create your banner</span>
      </div>
    {% endif %}
  </div>

  {% if banner_link != blank %}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Image banner link",
  "settings": [
    {
      "type": "header",
      "content": "Banner image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Alt text",
      "default": "Featured banner"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Shape",
      "options": [
        {
          "value": "3 / 1",
          "label": "Wide"
        },
        {
          "value": "2 / 1",
          "label": "Landscape"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        }
      ],
      "default": "3 / 1"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Link destination"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Image banner link"
    }
  ],
  "tag": null,
  "class": "image-banner-link-block"
}
{% endschema %}