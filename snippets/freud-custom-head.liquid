{% comment %}
  Freud Museum London — custom brand fonts + typography + overrides.
  Rendered once from layout/theme.liquid (immediately after base.css).

  Kept in its own snippet, included by a single {% render %} line, so a
  future Dawn theme update can replace layout/theme.liquid wholesale and
  only that one include line needs to be re-added — everything else here
  survives untouched. The bulk of the custom CSS itself lives in
  assets/freud-overrides.css for the same reason (see that file's header).
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Lato:wght@300;400;700;900&display=swap">
<style>
  :root{
    --font-heading-family: 'Crimson Text', Georgia, 'Times New Roman', serif !important;
    --font-heading-style: normal !important;
    --font-heading-weight: 400 !important;
    --font-body-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    --font-body-style: normal !important;
    --font-body-weight: 400 !important;
    --font-body-weight-bold: 700 !important;
  }
  /* Heading hierarchy */
  h1,.h1{
    font-family: 'Crimson Text', Georgia, 'Times New Roman', serif;
    font-size: 6.4rem;
    font-weight: normal;
    letter-spacing: -0.05rem;
  }
  h2,.h2{
    font-family: 'Crimson Text', Georgia, 'Times New Roman', serif;
    font-weight: 600;
    letter-spacing: -0.05rem;
  }
</style>
{{ 'freud-overrides.css' | asset_url | stylesheet_tag }}
