{% doc %}
  @prompt
    A horizontal banner with image, text overlayed to the right in H2 format and a button
    
    All elements should be editable, the image should be full width and the text should be white overlaid , Ok the text needs a heading and a subheading
    
    Heading H2
    Sub heading H3 
    Located further right in the last 1/3 of the imag
    
    The button should match the style of the other buttons on the page, The button doesn't have any styling?
    
    Text size doesn't change hwen using th econtrol
    
    Can you keep the image and my text as it is please when you update
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    max-width: 100%;
    min-height: {{ block.settings.banner_height }}px;
    overflow: hidden;
    background: #333333;
  }

  .ai-image-banner-{{ ai_gen_id }}__media,
  .ai-image-banner-{{ ai_gen_id }}__media img,
  .ai-image-banner-{{ ai_gen_id }}__placeholder,
  .ai-image-banner-{{ ai_gen_id }}__placeholder svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-image-banner-{{ ai_gen_id }}__media img,
  .ai-image-banner-{{ ai_gen_id }}__placeholder svg {
    object-fit: cover;
  }

  .ai-image-banner-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #55514a;
  }

  .ai-image-banner-{{ ai_gen_id }}__empty-state {
    position: absolute;
    bottom: 14px;
    left: 14px;
    padding: 8px 12px;
    background: #ffffff;
    color: #333333;
    font-size: 13px;
  }

  .ai-image-banner-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.04) 25%, rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 70%, rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%);
    pointer-events: none;
  }

  .ai-image-banner-{{ ai_gen_id }}__content {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    width: 33.333%;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 12px;
    padding: clamp(20px, 3vw, 52px);
    color: #ffffff;
    text-align: left;
    box-sizing: border-box;
  }

  .ai-image-banner-{{ ai_gen_id }}__heading {
    margin: 0;
    max-width: 20ch;
    color: #ffffff;
    font-size: {{ block.settings.heading_size }}px !important;
    line-height: 1.15;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }

  .ai-image-banner-{{ ai_gen_id }}__subheading {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: {{ block.settings.subheading_size }}px !important;
    line-height: 1.3;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }

  .ai-image-banner-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.5rem;
    padding: 0 3rem;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border: var(--buttons-border-width) solid rgba(var(--color-button), var(--buttons-border-opacity));
    border-radius: var(--buttons-radius);
    box-shadow: var(--shadow-horizontal-offset) var(--shadow-vertical-offset) var(--shadow-blur-radius) rgba(var(--color-shadow), var(--buttons-shadow-opacity));
    font-family: inherit;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: box-shadow 0.2s ease;
  }

  .ai-image-banner-{{ ai_gen_id }}__button:hover {
    box-shadow: 0 0 0 0.2rem rgba(var(--color-button), 0.25);
  }

  .ai-image-banner-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_image_height }}px;
    }

    .ai-image-banner-{{ ai_gen_id }}__content {
      width: 100%;
      padding: 24px;
    }

    .ai-image-banner-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.8 | floor }}px !important;
    }

    .ai-image-banner-{{ ai_gen_id }}__subheading {
      font-size: {{ block.settings.subheading_size | times: 0.8 | floor }}px !important;
    }

    .ai-image-banner-{{ ai_gen_id }}__shade {
      background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    }
  }
{% endstyle %}

<div class="ai-image-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-banner-{{ ai_gen_id }}__media">
    {% if block.settings.image != blank %}
      <img src="{{ block.settings.image | image_url: width: 2400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
    {% else %}
      <div class="ai-image-banner-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <span class="ai-image-banner-{{ ai_gen_id }}__empty-state">Add an image to complete this banner</span>
      </div>
    {% endif %}
  </div>
  <div class="ai-image-banner-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
  <div class="ai-image-banner-{{ ai_gen_id }}__content">
    {% if block.settings.heading != blank %}
      <h2 class="ai-image-banner-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    {% if block.settings.subheading != blank %}
      <h3 class="ai-image-banner-{{ ai_gen_id }}__subheading">{{ block.settings.subheading | escape }}</h3>
    {% endif %}
    {% if block.settings.button_label != blank and block.settings.button_link != blank %}
      <a class="ai-image-banner-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Horizontal image banner",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "range", "id": "banner_height", "label": "Desktop height", "min": 180, "max": 600, "step": 20, "unit": "px", "default": 360 },
    { "type": "range", "id": "mobile_image_height", "label": "Mobile height", "min": 120, "max": 400, "step": 20, "unit": "px", "default": 220 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover something meaningful" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Explore the Freud Museum Shop" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 60, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 16, "max": 36, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay strength", "min": 20, "max": 80, "step": 5, "unit": "%", "default": 45 }
  ],
  "presets": [{ "name": "Horizontal image banner" }],
  "tag": null,
  "class": "horizontal-image-banner"
}
{% endschema %}