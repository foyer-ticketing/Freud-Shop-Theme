{% doc %}
  @prompt
    Product title H1 and product description underneath that's all , Use the theme default font and add padding of 50px all round
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-copy-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 50px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-copy-{{ ai_gen_id }}__title {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    line-height: 1.15;
  }

  .ai-product-copy-{{ ai_gen_id }}__description {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
  }

  .ai-product-copy-{{ ai_gen_id }}__description p {
    margin: 0 0 1em;
  }

  .ai-product-copy-{{ ai_gen_id }}__description p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-product-copy-{{ ai_gen_id }} {
      width: 100%;
      padding: 50px;
    }

    .ai-product-copy-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-product-copy-{{ ai_gen_id }}__description {
      font-size: {{ block.settings.description_size | times: 0.95 }}px;
    }
  }
{% endstyle %}

<div class="ai-product-copy-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h1 class="ai-product-copy-{{ ai_gen_id }}__title">{{ product.title | escape }}</h1>

  {% if product.description != blank %}
    <div class="ai-product-copy-{{ ai_gen_id }}__description rte">
      {{ product.description }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product copy",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Title spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Product copy"
    }
  ],
  "tag": null,
  "class": "product-copy-block"
}
{% endschema %}