{% doc %}
  @prompt
    Update the selected Featured product block so its content uses the full available width while keeping the block visually compact with reduced vertical padding and no unnecessary empty space. Keep the price hidden. Make the product title an H2 and increase its default size. Add editor settings for the merchant to independently adjust the product title font size on desktop and mobile, plus vertical padding or overall section height, so the merchant can make future visual adjustments from the theme editor. Preserve responsive behavior and the current product content/layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-product-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.vertical_padding }}px 0;
    color: rgb(var(--color-foreground));
  }

  .ai-featured-product-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    width: 100%;
  }

  .ai-featured-product-{{ ai_gen_id }}__media {
    display: block;
    flex: 0 0 auto;
    width: 84px;
    height: 84px;
    overflow: hidden;
  }

  .ai-featured-product-{{ ai_gen_id }}__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-product-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: rgba(var(--color-foreground), 0.06);
  }

  .ai-featured-product-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-featured-product-{{ ai_gen_id }}__content {
    min-width: 0;
    flex: 1 1 auto;
  }

  .ai-featured-product-{{ ai_gen_id }}__title {
    margin: 0;
    font-size: {{ block.settings.title_size_desktop }}px;
    line-height: 1.15;
    font-weight: 700;
  }

  .ai-featured-product-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-featured-product-{{ ai_gen_id }}__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-product-{{ ai_gen_id }} {
      padding: {{ block.settings.vertical_padding }}px 0;
    }

    .ai-featured-product-{{ ai_gen_id }}__inner {
      gap: 14px;
    }

    .ai-featured-product-{{ ai_gen_id }}__media {
      width: 68px;
      height: 68px;
    }

    .ai-featured-product-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.title_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-featured-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.product != blank %}
    <div class="ai-featured-product-{{ ai_gen_id }}__inner">
      <a class="ai-featured-product-{{ ai_gen_id }}__media" href="{{ block.settings.product.url }}" aria-label="View {{ block.settings.product.title | escape }}">
        {% if block.settings.product.featured_image %}
          <img src="{{ block.settings.product.featured_image | image_url: width: 168 }}" alt="{{ block.settings.product.featured_image.alt | default: block.settings.product.title | escape }}" width="168" height="168" loading="lazy">
        {% else %}
          <div class="ai-featured-product-{{ ai_gen_id }}__placeholder">
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </a>
      <div class="ai-featured-product-{{ ai_gen_id }}__content">
        <h2 class="ai-featured-product-{{ ai_gen_id }}__title">
          <a href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a>
        </h2>
      </div>
    </div>
  {% else %}
    <div class="ai-featured-product-{{ ai_gen_id }}__inner">
      <div class="ai-featured-product-{{ ai_gen_id }}__media">
        <div class="ai-featured-product-{{ ai_gen_id }}__placeholder">
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        </div>
      </div>
      <div class="ai-featured-product-{{ ai_gen_id }}__content">
        <h2 class="ai-featured-product-{{ ai_gen_id }}__title">Select a product</h2>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Desktop font size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Mobile font size",
      "min": 14,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 22
    }
  ],
  "presets": [
    {
      "name": "Featured product"
    }
  ],
  "tag": null,
  "class": "featured-product-block"
}
{% endschema %}